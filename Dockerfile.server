# 观微后端：Express + tsx（shared/core 引擎以仓库根为构建上下文）
FROM node:22-alpine
WORKDIR /app
# 先装 server 依赖（利用层缓存）
COPY server/package.json server/package-lock.json ./server/
RUN cd server && npm ci --no-fund --no-audit
# 拷贝仓库（含 shared/ 引擎）
COPY . .
WORKDIR /app/server
EXPOSE 3018
CMD ["npx", "tsx", "src/index.ts"]
