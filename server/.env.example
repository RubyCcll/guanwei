# ===== AI 服务配置（必填） =====
# 选择 LLM 提供商：deepseek | gemini | groq | qwen | custom
LLM_PROVIDER=deepseek

# DeepSeek（默认推荐）
LLM_DEEPSEEK_KEY=sk-你的DeepSeek密钥
LLM_DEEPSEEK_MODEL=deepseek-chat

# Gemini（可选）
# LLM_GEMINI_KEY=
# LLM_GEMINI_MODEL=gemini-2.0-flash

# Groq（可选）
# LLM_GROQ_KEY=
# LLM_GROQ_MODEL=llama-3.3-70b-versatile

# 通义千问（可选）
# LLM_QWEN_KEY=
# LLM_QWEN_MODEL=qwen-turbo

# 自定义 OpenAI 兼容端点（可选）
# LLM_CUSTOM_KEY=
# LLM_CUSTOM_ENDPOINT=https://your-endpoint/v1/chat/completions
# LLM_CUSTOM_MODEL=gpt-4o-mini

# ===== 输出参数（可选） =====
# 单次报告最大输出 token（长报告约需 3-6K，默认 8192）
# LLM_MAX_TOKENS=8192

# ===== 服务端口（可选） =====
# PORT=3018
