#!/usr/bin/env bash
# ============================================================
# 观微 Guanwei CLI（支持：npm 全局安装 / npm link / 本地源码）
#
# 用法：
#   guanwei setup [--key xxx] [--provider xxx]     配置 API Key（存 ~/.guanwei/.env，更新不丢）
#   guanwei start [--dev] [--port 5173]            启动并自动打开浏览器
#   guanwei update                                 更新到最新版（全局：npm 升级；本地：git 增量合并）
#   guanwei check / status                         版本检查 / 状态
#   guanwei doctor                                 环境自检
#   guanwei stop                                   停止服务
#   guanwei web                                    仅打开浏览器
#   guanwei --help                                 帮助
# ============================================================
set -uo pipefail

# ── 定位项目根（支持 npm link / npm 全局安装的符号链接）──
SCRIPT_PATH=$(node -e "process.stdout.write(require('fs').realpathSync(process.argv[1]))" "$0" 2>/dev/null || echo "$0")
ROOT=$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)
GUANWEI_HOME="${GUANWEI_HOME:-${HOME}/.guanwei}"
ENV_FILE="${GUANWEI_HOME}/.env"
VERSION=$(node -e "console.log(require('${ROOT}/package.json').version)" 2>/dev/null || echo "?")
HEAD=$(git -C "${ROOT}" rev-parse --short HEAD 2>/dev/null || echo "pkg")
if [[ -d "${ROOT}/.git" ]]; then MODE="local"; else MODE="global"; fi

remote_head() { git ls-remote origin -h refs/heads/main 2>/dev/null | cut -f1; }
latest_tag()  { git ls-remote --tags origin 'refs/tags/v*' 2>/dev/null | sed 's|.*refs/tags/||' | sort -V | tail -1; }

cmd_help() {
  sed -n '3,19p' "$0" | sed 's/^# \{0,1\}//'
}

cmd_check() {
  if [[ "${MODE}" == "global" ]]; then
    local latest
    latest=$(npm view guanwei version 2>/dev/null || echo "?")
    if [[ "${latest}" == "${VERSION}" || "${latest}" == "?" ]]; then
      echo "✅ 已是最新版本（${VERSION}）"
    else
      echo "📦 有新版本：本地 ${VERSION} → npm ${latest}；运行：guanwei update"
    fi
  else
    local remote remoteTag
    remote=$(remote_head)
    remoteTag=$(latest_tag)
    if [[ -z "${remote}" ]]; then echo "⚠️  无法连接 GitHub"; return 0; fi
    if [[ "${HEAD}" == "${remote:0:7}" ]]; then
      echo "✅ 已是最新版本（${VERSION} · ${HEAD}）"
    else
      echo "📦 有新版本：本地 ${VERSION} · ${HEAD} → 远端 ${remoteTag} · ${remote:0:7}；运行：guanwei update"
    fi
  fi
}

cmd_status() {
  echo "观微 Guanwei"
  echo "  版本     : ${VERSION}（${MODE} 模式）"
  [[ "${MODE}" == "local" ]] && echo "  提交     : ${HEAD}"
  echo "  项目目录 : ${ROOT}"
  echo "  配置     : $([ -f "${ENV_FILE}" ] && echo "已配置（${ENV_FILE}）" || echo "未配置（运行 guanwei setup）")"
  local be_pid fe_pid
  be_pid=$(lsof -nP -iTCP:3018 -sTCP:LISTEN -t 2>/dev/null | head -1)
  fe_pid=$(lsof -nP -iTCP:${WEB_PORT:-5173} -sTCP:LISTEN -t 2>/dev/null | head -1)
  echo "  服务状态 : 后端 $([ -n "${be_pid}" ] && echo '运行中' || echo '未运行') · 前端 $([ -n "${fe_pid}" ] && echo '运行中' || echo '未运行')"
  cmd_check
}

cmd_setup() {
  local PROVIDER="" KEY="" CHOICE
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) PROVIDER="$2"; shift 2 ;;
      --key) KEY="$2"; shift 2 ;;
      *) echo "未知参数: $1"; exit 1 ;;
    esac
  done
  mkdir -p "${GUANWEI_HOME}"
  if [[ -z "${PROVIDER}" ]]; then
    if [[ -n "${KEY}" ]]; then PROVIDER=deepseek; else
      echo "选择 AI 服务商："
      echo "  1) DeepSeek（推荐）  2) Gemini  3) Groq  4) 通义千问  5) 自定义端点"
      read -rp "编号 [1]: " CHOICE
      case "${CHOICE:-1}" in
        1) PROVIDER=deepseek;; 2) PROVIDER=gemini;; 3) PROVIDER=groq;;
        4) PROVIDER=qwen;; 5) PROVIDER=custom;; *) echo "无效"; exit 1;;
      esac
    fi
  fi
  if [[ -z "${KEY}" ]]; then
    read -rsp "请输入 ${PROVIDER} API Key（不回显）: " KEY; echo
  fi
  [[ -z "${KEY}" ]] && { echo "错误：Key 不能为空"; exit 1; }
  {
    echo "# 由 guanwei setup 生成（$(date '+%Y-%m-%d %H:%M')）"
    echo "LLM_PROVIDER=${PROVIDER}"
    case "${PROVIDER}" in
      deepseek) echo "LLM_DEEPSEEK_KEY=${KEY}"; echo "LLM_DEEPSEEK_MODEL=deepseek-chat";;
      gemini)   echo "LLM_GEMINI_KEY=${KEY}";;
      groq)     echo "LLM_GROQ_KEY=${KEY}";;
      qwen)     echo "LLM_QWEN_KEY=${KEY}";;
      custom)
        echo "LLM_CUSTOM_KEY=${KEY}"
        read -rp "端点 URL [https://your-endpoint/v1/chat/completions]: " EP
        echo "LLM_CUSTOM_ENDPOINT=${EP:-https://your-endpoint/v1/chat/completions}";;
    esac
  } > "${ENV_FILE}"
  chmod 600 "${ENV_FILE}"
  echo "✅ 配置已保存：${ENV_FILE}（仅本机可读）"
}

cmd_start() {
  local DEV="" web_port="${WEB_PORT:-5173}" api_port="${API_PORT:-3018}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dev) DEV="1"; shift ;;
      --port) web_port="$2"; shift 2 ;;
      --api) api_port="$2"; shift 2 ;;
      *) echo "未知参数: $1"; exit 1 ;;
    esac
  done
  if [[ ! -f "${ENV_FILE}" ]]; then
    echo "⚠️  尚未配置，先运行：guanwei setup --key 你的APIKey"; exit 1
  fi
  set -a; source "${ENV_FILE}"; set +a
  export PORT="${api_port}"   # 后端实际监听端口

  local mode_label="生产"
  [[ -n "${DEV}" ]] && mode_label="开发"
  echo "🚀 启动观微（${mode_label}模式）"
  echo "   前端 : http://localhost:${web_port}   后端 : http://localhost:${api_port}"

  if [[ -n "${DEV}" ]]; then
    (cd "${ROOT}/server" && "${ROOT}/node_modules/.bin/tsx" watch src/index.ts >/dev/null 2>&1) &
    (cd "${ROOT}" && "${ROOT}/node_modules/.bin/vite" --port "${web_port}" >/dev/null 2>&1) &
  else
    (cd "${ROOT}/server" && "${ROOT}/node_modules/.bin/tsx" src/index.ts >/dev/null 2>&1) &
    (cd "${ROOT}" && "${ROOT}/node_modules/.bin/vite" preview --port "${web_port}" --strictPort --host 127.0.0.1 >/dev/null 2>&1) &
  fi

  for i in $(seq 1 30); do
    curl -sf "http://127.0.0.1:${api_port}/api/health" >/dev/null 2>&1 && break
    sleep 1
  done
  sleep 2
  if curl -sf -o /dev/null "http://127.0.0.1:${web_port}/" 2>/dev/null; then
    echo "✅ 已就绪，正在打开浏览器..."
    cmd_web "${web_port}" || true
  else
    echo "⚠️  前端暂未就绪，稍后访问 http://localhost:${web_port}"
  fi
  echo "   Ctrl+C 停止"
  wait
}

cmd_web() {
  local port="${1:-${WEB_PORT:-5173}}"
  local url="http://localhost:${port}"
  case "$(uname -s)" in
    Darwin) open "${url}" ;;
    Linux)  xdg-open "${url}" 2>/dev/null || echo "请打开浏览器访问: ${url}" ;;
    MINGW*|MSYS*|CYGWIN*) start "${url}" ;;
    *) echo "请打开浏览器访问: ${url}" ;;
  esac
}

cmd_update() {
  if [[ "${MODE}" == "global" ]]; then
    echo "📦 全局安装模式——通过 npm 升级..."
    npm i -g guanwei@latest 2>&1 | tail -2
    echo "✅ 升级完成，重启生效：guanwei start"
  else
    echo "🔍 检查远端更新..."
    git -C "${ROOT}" fetch origin 2>&1 | tail -1
    local remote; remote=$(remote_head)
    if [[ -z "${remote}" ]]; then echo "⚠️  无法连接 GitHub"; exit 1; fi
    if [[ "${HEAD}" == "${remote:0:7}" ]]; then echo "✅ 已是最新"; return 0; fi
    local dirty
    dirty=$(git -C "${ROOT}" status --porcelain --untracked-files=no 2>/dev/null | grep -v '^??' | head -5)
    if [[ -n "${dirty}" ]]; then
      echo "⚠️  本地未提交修改（不会覆盖）："; echo "${dirty}" | sed 's/^/    /'
      read -rp "  继续？[y/N] " ans
      [[ "${ans,,}" == "y" ]] || { echo "已取消"; exit 1; }
      git -C "${ROOT}" stash push -m "guanwei-update-auto" >/dev/null 2>&1 && STASHED=1
    fi
    echo "📦 增量更新..."
    git -C "${ROOT}" merge --ff-only origin/main 2>&1 | tail -2 || git -C "${ROOT}" pull --rebase origin main 2>&1 | tail -2
    echo "📦 安装依赖..."
    (cd "${ROOT}" && npm install --no-fund --no-audit 2>&1 | tail -1)
    (cd "${ROOT}/server" && npm install --no-fund --no-audit 2>&1 | tail -1)
    [[ -n "${STASHED:-}" ]] && git -C "${ROOT}" stash pop >/dev/null 2>&1 && echo "✅ 本地修改已恢复"
    echo "✅ 更新完成：$(node -e "console.log(require('${ROOT}/package.json').version)") · $(git -C "${ROOT}" rev-parse --short HEAD)"
  fi
}

cmd_doctor() {
  local ok=1
  echo "🩺 观微环境自检（${MODE} 模式）"
  echo "──────────────────────────────"
  if command -v node >/dev/null 2>&1; then
    echo "✅ Node.js $(node -v | sed 's/v//')"
  else
    echo "❌ 未检测到 Node.js"; ok=0
  fi
  if [[ -s "${ENV_FILE}" ]]; then
    if grep -qE "sk-你的|sk-test|your-" "${ENV_FILE}" 2>/dev/null; then
      echo "❌ 配置含占位/测试密钥——重新运行 guanwei setup"; ok=0
    else
      echo "✅ 已配置（LLM_PROVIDER=$(grep '^LLM_PROVIDER=' "${ENV_FILE}" | cut -d= -f2)）"
    fi
  else
    echo "❌ 未配置——运行 guanwei setup --key 你的APIKey"; ok=0
  fi
  echo "✅ 项目目录: ${ROOT}"
  local be fe
  be=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://localhost:3018/api/health 2>/dev/null || echo 0)
  fe=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://localhost:${WEB_PORT:-5173}/" 2>/dev/null || echo 0)
  [[ "${be}" == "200" ]] && echo "✅ 后端 3018 运行中" || echo "ℹ️  后端 3018 未运行"
  [[ "${fe}" == "200" ]] && echo "✅ 前端 ${WEB_PORT:-5173} 运行中" || echo "ℹ️  前端 ${WEB_PORT:-5173} 未运行"
  cmd_check
  echo "──────────────────────────────"
  [[ ${ok} -eq 1 ]] && echo "🎉 自检通过" || echo "🛠️  按提示修复后重试：guanwei doctor"
}

cmd_stop() {
  for port in 3018 ${WEB_PORT:-5173}; do
    local pid
    pid=$(lsof -nP -iTCP:${port} -sTCP:LISTEN -t 2>/dev/null | head -1)
    [[ -n "${pid}" ]] && kill "${pid}" 2>/dev/null && echo "已停止端口 ${port}（pid ${pid}）"
  done
  echo "✅ 停止命令已执行"
}

CMD="${1:-help}"
case "${CMD}" in
  setup)  shift; cmd_setup "$@" ;;
  start)  shift; cmd_start "$@" ;;
  web)    shift; cmd_web "$@" ;;
  update) cmd_update ;;
  check)  cmd_check ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  stop)   cmd_stop ;;
  help|-h|--help) cmd_help ;;
  *) echo "未知命令: ${CMD}"; cmd_help; exit 1 ;;
esac
